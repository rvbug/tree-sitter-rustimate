{
  "name": "tree-sitter-tree-sitter-rustimate",
  "version": "0.1.0",
  "description": "Tree-sitter grammar for the Rustimate Studio Language (RSL), a DSL for code-based storytelling and presentations",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rvbug/tree_sitter_rustimate.git"
  },
  "funding": "https://ko-fi.com/rvbugged",
  "license": "MIT",
  "author": {
    "name": "Rakesh Venkat",
    "email": "qubitai.in@gmail.com",
    "url": "https://qubitai.in"
  },
  "main": "bindings/node",
  "types": "bindings/node",
  "keywords": [
    "incremental",
    "parsing",
    "tree-sitter",
    "tree_sitter_rustimate"
  ],
  "files": [
    "grammar.js",
    "tree-sitter.json",
    "binding.gyp",
    "prebuilds/**",
    "bindings/node/*",
    "queries/*",
    "src/**",
    "*.wasm"
  ],
  "dependencies": {
    "node-addon-api": "^8.5.0",
    "node-gyp-build": "^4.8.4"
  },
  "devDependencies": {
    "prebuildify": "^6.0.1",
    "tree-sitter": "^0.25.0",
    "tree-sitter-cli": "^0.26.5"
  },
  "peerDependencies": {
    "tree-sitter": "^0.25.0"
  },
  "peerDependenciesMeta": {
    "tree-sitter": {
      "optional": true
    }
  },
  "scripts": {
    "install": "node-gyp-build",
    "prestart": "tree-sitter build --wasm",
    "start": "tree-sitter playground",
    "test": "node --test bindings/node/*_test.js"
  }
}
